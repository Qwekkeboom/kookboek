<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if page.title %}{{ page.title }}{% else %}Kookboek{% endif %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ site.base_url }}/assets/styles.css">
</head>
<body>
  <header class="site-header">
    <h1 class="site-title"><a href="{{ site.base_url }}/">Kookboek</a></h1>
    <p class="site-subtitle">Een collectie van recepten verzameld over de jaren heen</p>
  </header>

  <main class="main">
    <div class="container">
      {% assign is_recipe = false %}
      {% if page.data.category or page.data.prep_time or page.data.cook_time or page.data.servings or page.data.total_time %}
        {% assign is_recipe = true %}
      {% endif %}

      {% if is_recipe %}
      <article class="recipe-article">
        {% if page.title %}
        <h1 class="recipe-title">{{ page.title }}</h1>
        {% endif %}

        {% assign has_meta = false %}
        {% if page.data.servings or page.data.total_time or page.data.prep_time or page.data.cook_time %}
          {% assign has_meta = true %}
        {% endif %}

        {% if has_meta %}
        <div class="recipe-meta">
          {% if page.data.servings %}
          <div class="meta-item">Porties: {{ page.data.servings }}</div>
          {% endif %}
          {% if page.data.total_time %}
          <div class="meta-item">Totale tijd: {{ page.data.total_time }}</div>
          {% endif %}
          {% if page.data.prep_time %}
          <div class="meta-item">Voorbereiding: {{ page.data.prep_time }}</div>
          {% endif %}
          {% if page.data.cook_time %}
          <div class="meta-item">Kooktijd: {{ page.data.cook_time }}</div>
          {% endif %}
        </div>
        {% endif %}

        {{ page.content }}
      </article>
      {% else %}
      <div class="page-content">
        {{ page.content }}
      </div>
      {% endif %}
    </div>
  </main>

  <footer>
    <div class="container">Kookboek - met liefde verzameld</div>
  </footer>
</body>
</html>
