---
layout: default.liquid
title: Kookboek
---

{% assign main_categories = "Ontbijt,Dinner,Bakken" | split: "," %}

{% for category in main_categories %}
{% assign subcats = "|" %}
{% for post in collections.posts.pages %}
  {% if post.data.category == category %}
    {% assign key = "|" | append: post.data.subcategory | append: "|" %}
    {% unless subcats contains key %}
      {% assign subcats = subcats | append: post.data.subcategory | append: "|" %}
    {% endunless %}
  {% endif %}
{% endfor %}
{% assign subcategories = subcats | split: "|" | sort %}

<section class="category-section">
  <div class="category-header">
    <h2 class="category-title">{{ category }}</h2>
    <div class="category-rule"></div>
  </div>

  {% for subcategory in subcategories %}
  {% if subcategory != "" %}
  <div class="subcategory-block">
    <h3 class="subcategory-title">{{ subcategory | replace: "_", " " }}</h3>
    <div class="card-grid">
    {% for post in collections.posts.pages %}
    {% if post.data.category == category and post.data.subcategory == subcategory %}
    <div class="recipe-card">
      {% if post.data.image != "" %}
      <img class="card-image" src="{{ site.base_url }}/{{ post.data.image }}" alt="{{ post.title }}">
      {% else %}
        {% if post.data.category == "Ontbijt" %}
        <img class="card-image" src="{{ site.base_url }}/assets/images/category-ontbijt.svg" alt="Ontbijt">
        {% elsif post.data.category == "Bakken" %}
        <img class="card-image" src="{{ site.base_url }}/assets/images/category-bakken.svg" alt="Bakken">
        {% else %}
        <img class="card-image" src="{{ site.base_url }}/assets/images/category-dinner.svg" alt="Dinner">
        {% endif %}
      {% endif %}

      <div class="card-content">
        <div class="badges">
          <span class="badge">{{ post.data.category }}</span>
        </div>

        <h3 class="card-title"><a href="{{ post.permalink }}">{{ post.title }}</a></h3>
        {% if post.data.description %}
        <p class="card-desc">{{ post.data.description }}</p>
        {% endif %}

        {% if post.tags %}
        <div class="badges">
          {% for tag in post.tags %}
          <span class="tag tag-{{ tag | downcase | replace: " ", "-" | replace: "&", "en" }}">{{ tag }}</span>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}
    {% endfor %}
    </div>
  </div>
  {% endif %}
  {% endfor %}
</section>
{% endfor %}
